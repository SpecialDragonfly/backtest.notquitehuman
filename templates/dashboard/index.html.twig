{% extends 'base.html.twig' %}

{% block title %}Dashboard — Backtest{% endblock %}

{% block body %}
<div class="dashboard-layout">
<div class="dashboard-main">

<div class="card">
    <form method="get" action="/" id="dashboardForm" class="picker-row">
        <input type="hidden" name="layout" id="layoutInput" value="{{ layout }}">
        <div class="form-group">
            <label for="ticker">Ticker</label>
            <select id="ticker" name="ticker" onchange="this.form.submit()">
                {% for t in tickers %}
                    <option value="{{ t }}" {{ t == selectedTicker ? 'selected' : '' }}>{{ t }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="form-group">
            <label for="strategy">Strategy</label>
            <select id="strategy" name="strategy" onchange="this.form.submit()">
                {% for slug, label in strategies %}
                    <option value="{{ slug }}" {{ slug == selectedStrategy ? 'selected' : '' }}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>
    </form>
</div>

{% if isGuest %}
<div class="notice notice-info">Guest account has limited symbols.</div>
{% endif %}

{% if not hasData %}
<div class="card">
    <p>Not enough synced history for {{ symbol }} yet — needs at least 40 daily bars.</p>
</div>
{% else %}
<div class="card">
    <div class="stat-row">
        <div class="stat">
            <div class="stat-label">Compound return</div>
            <div class="stat-value {{ summary.compoundReturnPercent >= 0 ? 'positive' : 'negative' }}">{{ summary.compoundReturnPercent }}%</div>
        </div>
        <div class="stat">
            <div class="stat-label">Max drawdown</div>
            <div class="stat-value negative">{{ summary.maxDrawdownPercent }}%</div>
        </div>
        <div class="stat">
            <div class="stat-label">Trades</div>
            <div class="stat-value">{{ summary.trades }}</div>
        </div>
        <div class="stat">
            <div class="stat-label">Win rate</div>
            <div class="stat-value">{{ summary.winRate }}%</div>
        </div>
        <div class="stat">
            <div class="stat-label">Avg holding</div>
            <div class="stat-value">{{ summary.avgHoldingDays }}d</div>
        </div>
    </div>

    <div class="chart-wrap">
        <canvas id="priceChart"></canvas>
        <div class="chart-tooltip" id="chartTooltip"></div>
    </div>
    <div class="chart-legend" id="chartLegend">
        <span><span class="legend-line" style="background:#1c6dd0"></span> {{ symbol }} adj. close</span>
        <span><span class="legend-dot" style="background:#1a8754"></span> Buy</span>
        <span><span class="legend-dot" style="background:#c0362c"></span> Sell</span>
    </div>

    <div class="chart-wrap secondary-chart hidden" id="oscillatorPanel">
        <canvas id="oscillatorChart"></canvas>
        <div class="chart-tooltip" id="oscillatorTooltip"></div>
    </div>
    <div class="chart-legend" id="oscillatorLegend"></div>
</div>

{% if not isGuest %}
<div id="extraPanels"></div>
{% endif %}

<div class="card">
    <h2>Trade log</h2>
    {% if trades is empty %}
        <p>No completed trades for this strategy over the synced history.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Buy date</th>
                    <th class="num">Buy price</th>
                    <th>Sell date</th>
                    <th class="num">Sell price</th>
                    <th class="num">P/L %</th>
                    <th class="num">Days held</th>
                </tr>
            </thead>
            <tbody>
            {% for trade in trades %}
                <tr>
                    <td>{{ trade.buyTimestamp|date('Y-m-d') }}</td>
                    <td class="num">{{ trade.buyPrice|number_format(2) }}</td>
                    <td>{{ trade.sellTimestamp|date('Y-m-d') }}</td>
                    <td class="num">{{ trade.sellPrice|number_format(2) }}</td>
                    <td class="num {{ trade.profitPercent >= 0 ? 'positive' : 'negative' }}">{{ trade.profitPercent|number_format(2) }}</td>
                    <td class="num">{{ trade.durationDays }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endif %}

</div>{# /dashboard-main #}

{% if not isGuest %}
<div class="dashboard-sidebar">
    <div class="card">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:0.75rem;">
            <h2 style="margin:0;">Charts</h2>
            <button type="button" class="btn btn-secondary" id="addChartBtn">+ Add chart</button>
        </div>
        <ul class="chart-tree" id="chartSidebarTree"></ul>
    </div>

    <div class="card">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:0.75rem;">
            <h2 style="margin:0;">Lines</h2>
            <button type="button" class="btn btn-secondary" id="openLineModal">+ New</button>
        </div>
        {% if userLines is empty %}
            <p style="font-size:0.9rem; color:#5b6472; margin-top:0.75rem;">No lines yet.</p>
        {% else %}
            <div style="margin-top:0.75rem; display:flex; flex-direction:column;">
            {% for line in userLines %}
                <div class="sidebar-line-row">
                    <span>{{ line.name }}</span>
                    <form method="post" action="/lines/{{ line.id }}/delete">
                        <input type="hidden" name="redirect_to" value="/">
                        <button type="submit" class="line-delete-btn" title="Delete line">&times;</button>
                    </form>
                </div>
            {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="card">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:0.75rem;">
            <h2 style="margin:0;">Triggers</h2>
            {% if userLines|length >= 2 %}
                <button type="button" class="btn btn-secondary" id="openTriggerModal">+ New</button>
            {% endif %}
        </div>
        {% if tickerTriggerRows is empty %}
            <p style="font-size:0.9rem; color:#5b6472; margin-top:0.75rem;">No triggers for {{ selectedTicker }}.</p>
        {% else %}
            <div style="margin-top:0.75rem; display:flex; flex-direction:column; gap:0.75rem;">
            {% for row in tickerTriggerRows %}
                <div style="font-size:0.85rem; border:1px solid #edf0f2; border-radius:6px; padding:0.6rem 0.75rem;">
                    <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
                        <strong>{{ row.trigger.name }}</strong>
                        {% if row.trigger.active %}
                            <span class="badge badge-on">Armed</span>
                        {% else %}
                            <span class="badge badge-off">Disarmed</span>
                        {% endif %}
                    </div>
                    <div style="color:#5b6472; margin:0.3rem 0;">{{ row.lineAName }} is {{ row.operator == 'ABOVE' ? 'above' : 'below' }} {{ row.lineBName }}</div>
                    <div style="display:flex; gap:0.5rem;">
                        <form method="post" action="/triggers/{{ row.trigger.id }}/toggle">
                            <input type="hidden" name="redirect_to" value="/">
                            <button type="submit" class="btn btn-secondary" style="padding:0.3rem 0.6rem; font-size:0.8rem;">{{ row.trigger.active ? 'Disarm' : 'Arm' }}</button>
                        </form>
                        <form method="post" action="/triggers/{{ row.trigger.id }}/delete">
                            <input type="hidden" name="redirect_to" value="/">
                            <button type="submit" class="btn btn-secondary" style="padding:0.3rem 0.6rem; font-size:0.8rem;">Delete</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endif %}

</div>{# /dashboard-layout #}

{% if not isGuest %}
<div class="modal-overlay hidden" id="lineModal">
    <div class="modal-panel">
        <div class="modal-header">
            <h2>Line Configuration</h2>
            <button type="button" class="modal-close" id="closeLineModal" aria-label="Close">&times;</button>
        </div>
        <form method="post" action="/lines">
            <input type="hidden" name="redirect_to" value="/">
            <div class="form-group">
                <label for="lineName">Name</label>
                <input type="text" id="lineName" name="name" placeholder="e.g. 50-day SMA" required>
            </div>

            <div class="field-chain-label">Line is</div>
            <div class="field-chain">
                <select id="lineFn" name="fn">
                    <option value="PRICE">Price</option>
                    <option value="SMA" selected>SMA</option>
                    <option value="EMA">EMA</option>
                    <option value="RSI">RSI</option>
                    <option value="CONSTANT">Constant</option>
                </select>
                <div class="form-group" id="linePeriodGroup" style="margin-bottom:0;">
                    <label for="linePeriod">Period</label>
                    <input type="number" id="linePeriod" name="period" min="1" value="50">
                </div>
                <div class="form-group" id="lineValueGroup" style="display:none; margin-bottom:0;">
                    <label for="lineValue">Value</label>
                    <input type="number" id="lineValue" name="value" step="any">
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelLineModal">Cancel</button>
                <button type="submit" class="btn">Add line</button>
            </div>
        </form>
    </div>
</div>

{% if userLines|length >= 2 %}
<div class="modal-overlay hidden" id="triggerModal">
    <div class="modal-panel">
        <div class="modal-header">
            <h2>Trigger Configuration</h2>
            <button type="button" class="modal-close" id="closeTriggerModal" aria-label="Close">&times;</button>
        </div>
        <form method="post" action="/triggers">
            <input type="hidden" name="redirect_to" value="/">
            <input type="hidden" name="ticker" value="{{ selectedTicker }}">
            <div class="form-group">
                <label for="triggerName">Name</label>
                <input type="text" id="triggerName" name="name" placeholder="e.g. Golden cross" required>
            </div>
            <div class="form-group">
                <label>For ticker</label>
                <input type="text" value="{{ selectedTicker }}" disabled>
            </div>

            <div class="field-chain-label">Trigger when</div>
            <div class="field-chain">
                <select name="line_a_id" aria-label="Line A">
                    {% for line in userLines %}
                        <option value="{{ line.id }}">{{ line.name }}</option>
                    {% endfor %}
                </select>
                <select name="operator" aria-label="Condition">
                    <option value="ABOVE">is above</option>
                    <option value="BELOW">is below</option>
                </select>
                <select name="line_b_id" aria-label="Line B">
                    {% for line in userLines %}
                        <option value="{{ line.id }}" {{ loop.index == 2 ? 'selected' : '' }}>{{ line.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelTriggerModal">Cancel</button>
                <button type="submit" class="btn">Add trigger</button>
            </div>
        </form>
    </div>
</div>
{% endif %}
{% endif %}

<script id="chart-data" type="application/json">{{ chartDataJson|raw }}</script>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var dataEl = document.getElementById('chart-data');
    if (!dataEl) return;
    var data = JSON.parse(dataEl.textContent);
    var prices = data.prices;
    if (!prices || prices.length === 0) return;

    var padding = { top: 16, right: 16, bottom: 28, left: 56 };
    var dpr = window.devicePixelRatio || 1;

    var minT = prices[0].t, maxT = prices[prices.length - 1].t;
    var minC = Infinity, maxC = -Infinity;
    prices.forEach(function (p) {
        if (p.c < minC) minC = p.c;
        if (p.c > maxC) maxC = p.c;
    });
    var cPad = (maxC - minC) * 0.06;
    minC -= cPad; maxC += cPad;

    function xFor(t, w) {
        return padding.left + (t - minT) / (maxT - minT) * (w - padding.left - padding.right);
    }
    function yFor(c, h) {
        return padding.top + (1 - (c - minC) / (maxC - minC)) * (h - padding.top - padding.bottom);
    }
    function nearestIndex(x, w) {
        var t = minT + (x - padding.left) / (w - padding.left - padding.right) * (maxT - minT);
        var lo = 0, hi = prices.length - 1;
        while (lo < hi) {
            var mid = (lo + hi) >> 1;
            if (prices[mid].t < t) lo = mid + 1; else hi = mid;
        }
        return lo;
    }

    // Every owned Line, index-aligned with `prices` — see
    // App\Controller\DashboardController::index(). Which lines appear on
    // which chart panel is purely client-side layout state (see below), not
    // baked into this payload.
    var allLines = data.lines || [];
    var linesById = {};
    allLines.forEach(function (l) { linesById[l.id] = l; });
    var palette = ['#b3690a', '#7e3ff2', '#0a9396', '#c9184a', '#495057', '#1c6dd0', '#7f8c00'];
    function colorFor(lineId) {
        var idx = allLines.findIndex(function (l) { return l.id === lineId; });
        return palette[Math.max(idx, 0) % palette.length];
    }

    // -- Panel layout: panels[0] is always the main chart; the rest are
    // user-added blank panels. Restored from the layoutInput hidden field
    // (itself seeded from ?layout= — see DashboardController), and kept in
    // sync with both that field and the URL on every change so a reload or
    // a shared link reproduces the same layout. Never sent to the server
    // for validation — line ids not present in allLines are simply dropped.
    var layoutInput = document.getElementById('layoutInput');

    function loadLayout() {
        var raw = layoutInput ? layoutInput.value : '';
        var parsed = null;
        if (raw) {
            try { parsed = JSON.parse(raw); } catch (e) { parsed = null; }
        }
        var mainLines = [];
        var extra = [];
        if (parsed && Array.isArray(parsed.panels)) {
            parsed.panels.forEach(function (p) {
                var validLines = Array.isArray(p.lines) ? p.lines.filter(function (id) { return linesById[id]; }) : [];
                if (p.id === 'main') {
                    mainLines = validLines;
                } else if (typeof p.id === 'string' && p.id) {
                    extra.push({ id: p.id, lines: validLines });
                }
            });
        }
        return [{ id: 'main', lines: mainLines }].concat(extra);
    }

    var panels = loadLayout();

    function findPanel(id) {
        for (var i = 0; i < panels.length; i++) if (panels[i].id === id) return panels[i];
        return null;
    }

    function persistLayout() {
        var json = JSON.stringify({ panels: panels });
        if (layoutInput) layoutInput.value = json;
        if (window.history && window.history.replaceState) {
            try {
                var url = new URL(window.location.href);
                url.searchParams.set('layout', json);
                window.history.replaceState(null, '', url.toString());
            } catch (e) { /* URL API unsupported — layoutInput still carries state through a real submit */ }
        }
    }
    persistLayout(); // normalizes away any stale/invalid ids from a tampered URL

    function appendLegendEntries(legendEl, lines, panelId) {
        lines.forEach(function (line) {
            var span = document.createElement('span');
            var dot = document.createElement('span');
            dot.className = 'legend-line';
            dot.style.background = colorFor(line.id);
            span.appendChild(dot);
            span.appendChild(document.createTextNode(' ' + line.name + ' '));
            var remove = document.createElement('span');
            remove.className = 'legend-remove';
            remove.textContent = '×';
            remove.title = 'Remove from this chart';
            remove.addEventListener('click', function () { removeLineFromPanel(panelId, line.id); });
            span.appendChild(remove);
            legendEl.appendChild(span);
        });
    }

    // -- Panel/line management, driven entirely from the sidebar's Charts
    // tree (see renderSidebar below) — this is the single place lines get
    // added to/removed from a chart panel, and panels get added/removed.
    // The chart-panel legends' own "×" above call into the same functions,
    // so either surface stays in sync with the other.
    function rerenderPanel(panelId) {
        if (panelId === 'main') { renderMain(); return; }
        var found = extraPanelRenderers.filter(function (r) { return r.panel.id === panelId; })[0];
        if (found) found.render();
    }

    function removeLineFromPanel(panelId, lineId) {
        var panel = findPanel(panelId);
        if (!panel) return;
        panel.lines = panel.lines.filter(function (id) { return id !== lineId; });
        persistLayout();
        rerenderPanel(panelId);
        renderSidebar();
    }

    function addLineToPanel(panelId, lineId) {
        var panel = findPanel(panelId);
        if (!panel) return;
        if (panel.lines.indexOf(lineId) === -1) panel.lines.push(lineId);
        persistLayout();
        rerenderPanel(panelId);
        renderSidebar();
    }

    function removePanel(panelId) {
        panels = panels.filter(function (p) { return p.id !== panelId; });
        var found = extraPanelRenderers.filter(function (r) { return r.panel.id === panelId; })[0];
        if (found) found.el.remove();
        extraPanelRenderers = extraPanelRenderers.filter(function (r) { return r.panel.id !== panelId; });
        persistLayout();
        renderSidebar();
    }

    function panelLabel(panel) {
        if (panel.id === 'main') return 'Main chart';
        return 'Chart ' + (panels.indexOf(panel) + 1);
    }

    // Builds one <li> of the sidebar tree: a group name (Overlays/Oscillator
    // for the main chart, or the chart's own label for an extra panel), the
    // lines currently assigned to it as child <li>s each with a "×", and a
    // "+ Add line…" select of whichever of the user's lines aren't on it yet.
    function buildChartGroup(label, panel, scaleFilter, removable) {
        var li = document.createElement('li');
        li.className = 'chart-tree-item';

        var header = document.createElement('div');
        header.className = 'chart-tree-header';
        var titleSpan = document.createElement('span');
        titleSpan.textContent = label;
        header.appendChild(titleSpan);
        if (removable) {
            var removeChartBtn = document.createElement('button');
            removeChartBtn.type = 'button';
            removeChartBtn.className = 'chart-section-remove';
            removeChartBtn.textContent = 'Remove chart';
            removeChartBtn.addEventListener('click', function () { removePanel(panel.id); });
            header.appendChild(removeChartBtn);
        }
        li.appendChild(header);

        var childUl = document.createElement('ul');
        childUl.className = 'chart-tree-lines';

        var assignedLines = panel.lines.map(function (id) { return linesById[id]; }).filter(Boolean).filter(scaleFilter);
        if (assignedLines.length === 0) {
            var emptyLi = document.createElement('li');
            emptyLi.className = 'chart-tree-line chart-tree-line-empty';
            emptyLi.textContent = 'None assigned.';
            childUl.appendChild(emptyLi);
        } else {
            assignedLines.forEach(function (line) {
                var lineLi = document.createElement('li');
                lineLi.className = 'chart-tree-line';
                var left = document.createElement('span');
                left.className = 'chart-tree-line-label';
                var dot = document.createElement('span');
                dot.className = 'legend-line';
                dot.style.background = colorFor(line.id);
                left.appendChild(dot);
                left.appendChild(document.createTextNode(line.name));
                lineLi.appendChild(left);
                var removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.className = 'line-delete-btn';
                removeBtn.textContent = '×';
                removeBtn.title = 'Remove from this chart';
                removeBtn.addEventListener('click', function () { removeLineFromPanel(panel.id, line.id); });
                lineLi.appendChild(removeBtn);
                childUl.appendChild(lineLi);
            });
        }

        var available = allLines.filter(function (l) { return panel.lines.indexOf(l.id) === -1 && scaleFilter(l); });
        if (available.length > 0) {
            var addLi = document.createElement('li');
            addLi.className = 'chart-tree-line chart-tree-add';
            var select = document.createElement('select');
            select.className = 'chart-add-line-select';
            var placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = '+ Add line…';
            select.appendChild(placeholder);
            available.forEach(function (l) {
                var opt = document.createElement('option');
                opt.value = String(l.id);
                opt.textContent = l.name;
                select.appendChild(opt);
            });
            select.addEventListener('change', function () {
                var id = parseInt(select.value, 10);
                if (id) addLineToPanel(panel.id, id);
            });
            addLi.appendChild(select);
            childUl.appendChild(addLi);
        }

        li.appendChild(childUl);
        return li;
    }

    function renderSidebar() {
        var tree = document.getElementById('chartSidebarTree');
        if (!tree) return;
        tree.innerHTML = '';
        var mainPanel = findPanel('main');
        tree.appendChild(buildChartGroup('Overlays', mainPanel, function (l) { return l.scale !== 'oscillator'; }, false));
        tree.appendChild(buildChartGroup('Oscillator', mainPanel, function (l) { return l.scale === 'oscillator'; }, false));
        panels.slice(1).forEach(function (panel) {
            tree.appendChild(buildChartGroup(panelLabel(panel), panel, function () { return true; }, true));
        });
    }

    // -- Main panel: price + strategy signals (unchanged) plus whichever
    // Lines are assigned to it, split by scale like the secondary-panel
    // feature already established (oscillator-scaled Lines get the fixed
    // 0-100 sub-panel instead of squashing against the price axis).
    var canvas = document.getElementById('priceChart');
    var tooltip = document.getElementById('chartTooltip');
    var ctx = canvas.getContext('2d');
    var oscPanel = document.getElementById('oscillatorPanel');
    var oscCanvas = document.getElementById('oscillatorChart');
    var oscTooltip = document.getElementById('oscillatorTooltip');
    var oscLegend = document.getElementById('oscillatorLegend');
    var octx = oscCanvas.getContext('2d');

    function mainPanelLines() {
        var panel = findPanel('main');
        return panel.lines.map(function (id) { return linesById[id]; }).filter(Boolean);
    }

    function drawMain() {
        var overlayLines = mainPanelLines().filter(function (l) { return l.scale !== 'oscillator'; });

        var w = canvas.clientWidth, h = canvas.clientHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);

        ctx.strokeStyle = '#edf0f2';
        ctx.fillStyle = '#5b6472';
        ctx.font = '11px Inter, sans-serif';
        ctx.lineWidth = 1;
        for (var i = 0; i <= 4; i++) {
            var c = minC + (maxC - minC) * (i / 4);
            var y = yFor(c, h);
            ctx.beginPath();
            ctx.moveTo(padding.left, y);
            ctx.lineTo(w - padding.right, y);
            ctx.stroke();
            ctx.fillText(c.toFixed(0), 6, y + 3);
        }

        ctx.strokeStyle = '#1c6dd0';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        prices.forEach(function (p, idx) {
            var x = xFor(p.t, w), yy = yFor(p.c, h);
            if (idx === 0) ctx.moveTo(x, yy); else ctx.lineTo(x, yy);
        });
        ctx.stroke();

        overlayLines.forEach(function (line) {
            ctx.strokeStyle = colorFor(line.id);
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            var started = false;
            line.points.forEach(function (p) {
                if (p.v === null) { started = false; return; }
                var x = xFor(p.t, w), yy = yFor(p.v, h);
                if (!started) { ctx.moveTo(x, yy); started = true; } else { ctx.lineTo(x, yy); }
            });
            ctx.stroke();
        });

        (data.signals || []).forEach(function (s) {
            var x = xFor(s.t, w), yy = yFor(s.p, h);
            ctx.beginPath();
            ctx.fillStyle = s.type === 'BUY' ? '#1a8754' : '#c0362c';
            ctx.arc(x, yy, 3.5, 0, Math.PI * 2);
            ctx.fill();
        });

        var legend = document.getElementById('chartLegend');
        legend.innerHTML =
            '<span><span class="legend-line" style="background:#1c6dd0"></span> {{ symbol }} adj. close</span>' +
            '<span><span class="legend-dot" style="background:#1a8754"></span> Buy</span>' +
            '<span><span class="legend-dot" style="background:#c0362c"></span> Sell</span>';
        appendLegendEntries(legend, overlayLines, 'main');
    }

    function drawOscillator() {
        var oscillatorLines = mainPanelLines().filter(function (l) { return l.scale === 'oscillator'; });
        oscPanel.classList.toggle('hidden', oscillatorLines.length === 0);
        if (oscillatorLines.length === 0) { oscLegend.innerHTML = ''; return; }

        var w = oscCanvas.clientWidth, h = oscCanvas.clientHeight;
        oscCanvas.width = w * dpr;
        oscCanvas.height = h * dpr;
        octx.setTransform(dpr, 0, 0, dpr, 0, 0);
        octx.clearRect(0, 0, w, h);

        function oscYFor(v, hh) { return padding.top + (1 - v / 100) * (hh - padding.top - padding.bottom); }

        [0, 30, 70, 100].forEach(function (v) {
            var y = oscYFor(v, h);
            octx.strokeStyle = (v === 30 || v === 70) ? '#e0a94a' : '#edf0f2';
            octx.lineWidth = 1;
            octx.beginPath();
            octx.moveTo(padding.left, y);
            octx.lineTo(w - padding.right, y);
            octx.stroke();
            octx.fillStyle = '#5b6472';
            octx.font = '11px Inter, sans-serif';
            octx.fillText(String(v), 6, y + 3);
        });

        oscillatorLines.forEach(function (line) {
            octx.strokeStyle = colorFor(line.id);
            octx.lineWidth = 1.5;
            octx.beginPath();
            var started = false;
            line.points.forEach(function (p) {
                if (p.v === null) { started = false; return; }
                var x = xFor(p.t, w), y = oscYFor(p.v, h);
                if (!started) { octx.moveTo(x, y); started = true; } else { octx.lineTo(x, y); }
            });
            octx.stroke();
        });

        oscLegend.innerHTML = '';
        appendLegendEntries(oscLegend, oscillatorLines, 'main');
    }

    function renderMain() { drawMain(); drawOscillator(); }

    canvas.addEventListener('mousemove', function (e) {
        var rect = canvas.getBoundingClientRect();
        var x = e.clientX - rect.left, w = canvas.clientWidth, h = canvas.clientHeight;
        var i = nearestIndex(x, w);
        var p = prices[i];
        if (!p) return;
        var px = xFor(p.t, w), py = yFor(p.c, h);
        tooltip.style.left = px + 'px';
        tooltip.style.top = (py - 10) + 'px';
        tooltip.style.opacity = '1';
        var d = new Date(p.t * 1000);
        var text = d.toISOString().slice(0, 10) + '  ' + p.c.toFixed(2);
        mainPanelLines().forEach(function (line) {
            var lv = line.points[i] ? line.points[i].v : null;
            if (lv !== null) text += '\n' + line.name + ': ' + lv.toFixed(2);
        });
        tooltip.textContent = text;
    });
    canvas.addEventListener('mouseleave', function () { tooltip.style.opacity = '0'; });

    oscCanvas.addEventListener('mousemove', function (e) {
        var lines = mainPanelLines().filter(function (l) { return l.scale === 'oscillator'; });
        if (lines.length === 0) return;
        var rect = oscCanvas.getBoundingClientRect();
        var x = e.clientX - rect.left, w = oscCanvas.clientWidth;
        var i = nearestIndex(x, w);
        var p = prices[i];
        if (!p) return;
        var px = xFor(p.t, w);
        var d = new Date(p.t * 1000);
        var text = d.toISOString().slice(0, 10);
        var any = false;
        lines.forEach(function (line) {
            var lv = line.points[i] ? line.points[i].v : null;
            if (lv !== null) { text += '\n' + line.name + ': ' + lv.toFixed(2); any = true; }
        });
        if (!any) return;
        oscTooltip.style.left = px + 'px';
        oscTooltip.style.top = '10px';
        oscTooltip.style.opacity = '1';
        oscTooltip.textContent = text;
    });
    oscCanvas.addEventListener('mouseleave', function () { oscTooltip.style.opacity = '0'; });

    // -- Extra (blank) panels: no price line/signals, auto-fit to whatever
    // Lines are dropped on them. Mixing a price-scaled and an
    // oscillator-scaled Line on the same blank panel isn't handled specially
    // (both share one auto-fit axis) — a known limitation, not a bug.
    var extraPanelRenderers = [];

    function panelVDomain(lines) {
        var minV = Infinity, maxV = -Infinity;
        lines.forEach(function (line) {
            line.points.forEach(function (p) {
                if (p.v !== null) { if (p.v < minV) minV = p.v; if (p.v > maxV) maxV = p.v; }
            });
        });
        if (minV === Infinity) { minV = 0; maxV = 1; }
        var vPad = (maxV - minV) * 0.06 || 1;
        minV -= vPad; maxV += vPad;
        return {
            minV: minV, maxV: maxV,
            yForV: function (v, h) { return padding.top + (1 - (v - minV) / (maxV - minV)) * (h - padding.top - padding.bottom); },
        };
    }

    function createPanelElement(panel) {
        var card = document.createElement('div');
        card.className = 'card';

        var header = document.createElement('div');
        header.className = 'chart-panel-header';
        var title = document.createElement('h3');
        title.textContent = panelLabel(panel);
        header.appendChild(title);
        card.appendChild(header);

        var blank = document.createElement('div');
        blank.className = 'blank-panel';
        var placeholder = document.createElement('div');
        placeholder.className = 'blank-panel-placeholder';
        placeholder.textContent = 'No lines on this chart yet — add one from the Charts panel in the sidebar.';
        blank.appendChild(placeholder);
        card.appendChild(blank);

        var chartWrap = document.createElement('div');
        chartWrap.className = 'chart-wrap hidden';
        var pCanvas = document.createElement('canvas');
        var pTooltip = document.createElement('div');
        pTooltip.className = 'chart-tooltip';
        chartWrap.appendChild(pCanvas);
        chartWrap.appendChild(pTooltip);
        card.appendChild(chartWrap);

        var legend = document.createElement('div');
        legend.className = 'chart-legend';
        card.appendChild(legend);

        var pctx = pCanvas.getContext('2d');

        function render() {
            title.textContent = panelLabel(panel);
            var lines = panel.lines.map(function (id) { return linesById[id]; }).filter(Boolean);
            if (lines.length === 0) {
                blank.classList.remove('hidden');
                chartWrap.classList.add('hidden');
                legend.innerHTML = '';
                return;
            }
            blank.classList.add('hidden');
            chartWrap.classList.remove('hidden');

            var w = pCanvas.clientWidth, h = pCanvas.clientHeight;
            pCanvas.width = w * dpr;
            pCanvas.height = h * dpr;
            pctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            pctx.clearRect(0, 0, w, h);

            var domain = panelVDomain(lines);
            pctx.strokeStyle = '#edf0f2';
            pctx.fillStyle = '#5b6472';
            pctx.font = '11px Inter, sans-serif';
            pctx.lineWidth = 1;
            for (var i = 0; i <= 4; i++) {
                var v = domain.minV + (domain.maxV - domain.minV) * (i / 4);
                var y = domain.yForV(v, h);
                pctx.beginPath();
                pctx.moveTo(padding.left, y);
                pctx.lineTo(w - padding.right, y);
                pctx.stroke();
                pctx.fillText(v.toFixed(1), 6, y + 3);
            }

            lines.forEach(function (line) {
                pctx.strokeStyle = colorFor(line.id);
                pctx.lineWidth = 1.5;
                pctx.beginPath();
                var started = false;
                line.points.forEach(function (p) {
                    if (p.v === null) { started = false; return; }
                    var x = xFor(p.t, w), y = domain.yForV(p.v, h);
                    if (!started) { pctx.moveTo(x, y); started = true; } else { pctx.lineTo(x, y); }
                });
                pctx.stroke();
            });

            legend.innerHTML = '';
            appendLegendEntries(legend, lines, panel.id);
        }

        pCanvas.addEventListener('mousemove', function (e) {
            var lines = panel.lines.map(function (id) { return linesById[id]; }).filter(Boolean);
            if (lines.length === 0) return;
            var rect = pCanvas.getBoundingClientRect();
            var x = e.clientX - rect.left, w = pCanvas.clientWidth;
            var i = nearestIndex(x, w);
            var p = prices[i];
            if (!p) return;
            var domain = panelVDomain(lines);
            var px = xFor(p.t, w);
            var d = new Date(p.t * 1000);
            var text = d.toISOString().slice(0, 10);
            var any = false;
            lines.forEach(function (line) {
                var lv = line.points[i] ? line.points[i].v : null;
                if (lv !== null) { text += '\n' + line.name + ': ' + lv.toFixed(2); any = true; }
            });
            if (!any) return;
            pTooltip.style.left = px + 'px';
            pTooltip.style.top = '10px';
            pTooltip.style.opacity = '1';
            pTooltip.textContent = text;
        });
        pCanvas.addEventListener('mouseleave', function () { pTooltip.style.opacity = '0'; });

        extraPanelRenderers.push({ panel: panel, render: render, el: card });
        return card;
    }

    var addChartBtn = document.getElementById('addChartBtn');
    if (addChartBtn) {
        addChartBtn.addEventListener('click', function () {
            var panel = { id: 'p' + Date.now(), lines: [] };
            panels.push(panel);
            var el = createPanelElement(panel);
            document.getElementById('extraPanels').appendChild(el);
            persistLayout();
            renderSidebar();
        });
    }

    // Restore any extra panels from a reloaded/shared layout.
    panels.slice(1).forEach(function (panel) {
        var el = createPanelElement(panel);
        document.getElementById('extraPanels').appendChild(el);
    });

    function redrawAll() {
        renderMain();
        extraPanelRenderers.forEach(function (r) { r.render(); });
    }
    redrawAll();
    renderSidebar();
    window.addEventListener('resize', redrawAll);
})();
</script>

<script>
(function () {
    function wireModal(modalId, openId, closeId, cancelId) {
        var modal = document.getElementById(modalId);
        var openBtn = document.getElementById(openId);
        if (!modal || !openBtn) return;

        function open() { modal.classList.remove('hidden'); }
        function close() { modal.classList.add('hidden'); }

        openBtn.addEventListener('click', open);
        var closeBtn = document.getElementById(closeId);
        var cancelBtn = document.getElementById(cancelId);
        if (closeBtn) closeBtn.addEventListener('click', close);
        if (cancelBtn) cancelBtn.addEventListener('click', close);
        modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
    }

    wireModal('lineModal', 'openLineModal', 'closeLineModal', 'cancelLineModal');
    wireModal('triggerModal', 'openTriggerModal', 'closeTriggerModal', 'cancelTriggerModal');

    var lineFn = document.getElementById('lineFn');
    if (lineFn) {
        lineFn.addEventListener('change', function () {
            var fn = this.value;
            document.getElementById('linePeriodGroup').style.display = (fn === 'PRICE' || fn === 'CONSTANT') ? 'none' : '';
            document.getElementById('lineValueGroup').style.display = (fn === 'CONSTANT') ? '' : 'none';
        });
    }
})();
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Triggers — Backtest{% endblock %}

{% block body %}
<div class="card">
    <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
        <div>
            <h1>Triggers</h1>
            <p>Watch two of your Lines for one crossing above/below the other. When that first becomes true it's a firing — shown here across history, and (once armed) recorded as a live <a href="/alerts">Alert</a> the day it next happens for real.</p>
        </div>
        {% if lines|length >= 2 %}
            <button type="button" class="btn" id="openTriggerModal" style="white-space:nowrap;">+ New trigger</button>
        {% endif %}
    </div>

    {% if added %}
        <div class="notice notice-ok">{{ added }}.</div>
    {% endif %}
    {% if error %}
        <div class="notice notice-error">{{ error }}</div>
    {% endif %}

    {% if rows is empty %}
        <p>No triggers yet{{ lines|length < 2 ? ' — you need at least two Lines to build one' : ' — add one above' }}.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Ticker</th>
                    <th>Condition</th>
                    <th>Status</th>
                    <th>Historical fires</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for row in rows %}
                <tr>
                    <td>{{ row.trigger.name }}</td>
                    <td>{{ row.trigger.ticker }}</td>
                    <td>{{ row.lineAName }} is {{ row.operator == 'ABOVE' ? 'above' : 'below' }} {{ row.lineBName }}</td>
                    <td>
                        {% if row.trigger.active %}
                            <span class="badge badge-on">Armed</span>
                        {% else %}
                            <span class="badge badge-off">Disarmed</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if row.firedCount > 0 %}
                            {{ row.firedCount }}× — most recently {{ row.recentFiredDates|join(', ') }}
                        {% else %}
                            Never
                        {% endif %}
                    </td>
                    <td>
                        <form method="post" action="/triggers/{{ row.trigger.id }}/toggle" style="display:inline">
                            <button type="submit" class="btn btn-secondary">{{ row.trigger.active ? 'Disarm' : 'Arm' }}</button>
                        </form>
                        <form method="post" action="/triggers/{{ row.trigger.id }}/delete" style="display:inline">
                            <button type="submit" class="btn btn-secondary">Delete</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>

{% if lines|length >= 2 %}
<div class="modal-overlay hidden" id="triggerModal">
    <div class="modal-panel">
        <div class="modal-header">
            <h2>Trigger Configuration</h2>
            <button type="button" class="modal-close" id="closeTriggerModal" aria-label="Close">&times;</button>
        </div>
        <form method="post" action="/triggers">
            <div class="form-group">
                <label for="name">Name</label>
                <input type="text" id="name" name="name" placeholder="e.g. Golden cross" required>
            </div>
            <div class="form-group">
                <label for="ticker">For ticker</label>
                <select id="ticker" name="ticker">
                    {% for t in tickers %}
                        <option value="{{ t }}">{{ t }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="field-chain-label">Trigger when</div>
            <div class="field-chain">
                <select id="line_a_id" name="line_a_id" aria-label="Line A">
                    {% for line in lines %}
                        <option value="{{ line.id }}">{{ line.name }}</option>
                    {% endfor %}
                </select>
                <select id="operator" name="operator" aria-label="Condition">
                    <option value="ABOVE">is above</option>
                    <option value="BELOW">is below</option>
                </select>
                <select id="line_b_id" name="line_b_id" aria-label="Line B">
                    {% for line in lines %}
                        <option value="{{ line.id }}" {{ loop.index == 2 ? 'selected' : '' }}>{{ line.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelTriggerModal">Cancel</button>
                <button type="submit" class="btn">Add trigger</button>
            </div>
        </form>
    </div>
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var modal = document.getElementById('triggerModal');
    var openBtn = document.getElementById('openTriggerModal');
    if (!modal || !openBtn) return;

    function open() { modal.classList.remove('hidden'); }
    function close() { modal.classList.add('hidden'); }

    openBtn.addEventListener('click', open);
    document.getElementById('closeTriggerModal').addEventListener('click', close);
    document.getElementById('cancelTriggerModal').addEventListener('click', close);
    modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
})();
</script>
{% endblock %}

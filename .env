APP_ENV=dev
APP_DEBUG=true

# SQLite by default (local dev). To switch to MySQL/MariaDB (production, or
# local testing against the shared notquitehuman MariaDB server), set
# DB_CONNECTION=mysql plus the DB_* vars below. This site shares the *server*
# (nqh_db container) with notquitehuman.new but uses its own schema/user —
# it does not get its own DB container.
# Real credentials should never be committed here — set them directly in the
# server's own .env (not checked in) or via docker-compose `environment:`.
DB_CONNECTION=sqlite
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=notquitehuman_backtest
DB_USER=backtest
DB_PASS=
